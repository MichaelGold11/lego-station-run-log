{
  "version": 1,
  "name": "Wire splice line",
  "draft": "v1",
  "product": "Two wires joined by one crimped butt splice, then tested by lighting a bulb from a battery.",
  "taktSec": null,
  "holdFrames": 3,
  "qaGraceSec": 5,
  "defaults": { "activity": 0.1, "bright": 0.5, "class": 0.4 },
  "model": null,
  "suggestedClasses": ["wire", "stripped_end", "splice", "crimped_splice", "cutter", "stripper", "crimp_tool", "bulb_on", "bulb_off", "battery"],
  "failReasons": [
    { "id": "strip", "label": "Strip too short or long, or cut strands", "cause": "s1", "defect": true },
    { "id": "crimp_a", "label": "Side A crimp loose or off", "cause": "s2", "defect": true },
    { "id": "crimp_b", "label": "Side B crimp loose or off", "cause": "s3", "defect": true },
    { "id": "wire_damage", "label": "Wire damaged", "cause": "s1", "defect": true },
    { "id": "test_setup", "label": "Test setup problem (battery, bulb, clips)", "cause": "s4", "defect": false },
    { "id": "other", "label": "Other", "cause": null, "defect": true }
  ],
  "stations": [
    {
      "id": "s1",
      "label": "Cut and strip",
      "output": "a pair of wires per cycle",
      "note": "The operator repeats pick, cut and strip for the second wire inside one cycle, so going back to an earlier substep is a normal repeat.",
      "zones": [
        { "id": "supply", "label": "Wire supply" },
        { "id": "work", "label": "Cut and strip area" },
        { "id": "out", "label": "Out tray" }
      ],
      "cycleEnds": "s1_handoff",
      "substeps": [
        { "id": "s1_pick_wire", "label": "Pull wire from supply", "zones": { "zone": "supply", "signal": "activity" }, "model": null },
        { "id": "s1_measure_cut", "label": "Measure to the mark and cut", "zones": { "zone": "work", "signal": "activity" }, "model": { "zone": "work", "class": "cutter" } },
        { "id": "s1_strip", "label": "Strip both ends", "zones": null, "model": { "zone": "work", "class": "stripper" } },
        { "id": "s1_check", "label": "Check strands and strip length", "zones": null, "model": { "zone": "work", "class": "stripped_end" } },
        { "id": "s1_handoff", "label": "Place the pair in the out tray", "zones": { "zone": "out", "signal": "activity" }, "model": null }
      ]
    },
    {
      "id": "s2",
      "label": "Crimp side A",
      "output": "a wire pair with the splice crimped on wire A",
      "zones": [
        { "id": "in", "label": "In tray" },
        { "id": "parts", "label": "Splice bin" },
        { "id": "crimp", "label": "Crimp area" },
        { "id": "out", "label": "Out tray" }
      ],
      "cycleEnds": "s2_handoff",
      "substeps": [
        { "id": "s2_pick", "label": "Take a wire pair from the in tray", "zones": { "zone": "in", "signal": "activity" }, "model": null },
        { "id": "s2_get_splice", "label": "Take a splice", "zones": { "zone": "parts", "signal": "activity" }, "model": { "zone": "parts", "class": "splice" } },
        { "id": "s2_insert", "label": "Push wire A into the splice", "zones": { "zone": "crimp", "signal": "activity" }, "model": { "zone": "crimp", "class": "splice" } },
        { "id": "s2_crimp", "label": "Crimp side A", "zones": null, "model": { "zone": "crimp", "class": "crimp_tool" } },
        { "id": "s2_pull_test", "label": "Tug test side A", "zones": null, "model": { "zone": "crimp", "class": "crimped_splice" } },
        { "id": "s2_handoff", "label": "Pass to station 3", "zones": { "zone": "out", "signal": "activity" }, "model": null }
      ]
    },
    {
      "id": "s3",
      "label": "Crimp side B (join)",
      "output": "one joined unit",
      "zones": [
        { "id": "in", "label": "In tray" },
        { "id": "parts", "label": "Splice bin" },
        { "id": "crimp", "label": "Crimp area" },
        { "id": "out", "label": "Out tray" }
      ],
      "cycleEnds": "s3_handoff",
      "substeps": [
        { "id": "s3_pick", "label": "Take the half-done unit", "zones": { "zone": "in", "signal": "activity" }, "model": null },
        { "id": "s3_insert", "label": "Push wire B into the splice", "zones": { "zone": "crimp", "signal": "activity" }, "model": { "zone": "crimp", "class": "splice" } },
        { "id": "s3_crimp", "label": "Crimp side B", "zones": null, "model": { "zone": "crimp", "class": "crimp_tool" } },
        { "id": "s3_pull_test", "label": "Tug test both sides", "zones": null, "model": { "zone": "crimp", "class": "crimped_splice" } },
        { "id": "s3_handoff", "label": "Pass to QA", "zones": { "zone": "out", "signal": "activity" }, "model": null }
      ]
    },
    {
      "id": "s4",
      "label": "QA test",
      "output": "one tested unit, sorted into the pass or fail bin",
      "zones": [
        { "id": "in", "label": "In tray" },
        { "id": "fixture", "label": "Test fixture: battery + bulb clips" },
        { "id": "bulb", "label": "Bulb" },
        { "id": "pass_bin", "label": "Pass bin" },
        { "id": "fail_bin", "label": "Fail bin" }
      ],
      "cycleEnds": "s4_sort",
      "qa": {
        "lightSubstep": "s4_test",
        "sortSubstep": "s4_sort",
        "bins": { "pass_bin": "pass", "fail_bin": "fail" }
      },
      "substeps": [
        { "id": "s4_pick", "label": "Take unit from the in tray", "zones": { "zone": "in", "signal": "activity" }, "model": null },
        { "id": "s4_connect", "label": "Clip the ends to the battery and bulb", "zones": { "zone": "fixture", "signal": "activity" }, "model": null },
        { "id": "s4_test", "label": "Bulb test", "zones": { "zone": "bulb", "signal": "bright" }, "model": { "zone": "bulb", "class": "bulb_on" } },
        { "id": "s4_disconnect", "label": "Unclip", "zones": null, "model": null, "note": "Model only. The model team picks the class that shows the clips coming off." },
        { "id": "s4_sort", "label": "Sort into pass or fail bin", "zones": { "anyOf": [ { "zone": "pass_bin", "signal": "activity" }, { "zone": "fail_bin", "signal": "activity" } ] }, "model": null }
      ]
    }
  ]
}
