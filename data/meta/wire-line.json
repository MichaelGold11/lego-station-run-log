{
  "version": 1,
  "name": "Wire lever-connector line",
  "draft": "v2",
  "product": "Three wires (red, white, black) cut to length against a ruler, laid in color order (red top, white middle, black bottom) and closed in a 3-port lever connector. A second lever connector joins the other end of the red wire to a separate black wire. QA is a pull test: no wire may come out of either connector.",
  "taktSec": null,
  "holdFrames": 3,
  "qaGraceSec": 5,
  "defaults": { "activity": 0.1, "bright": 0.5, "class": 0.4 },
  "model": null,
  "capture": { "enabled": true, "stallSec": 12, "sampleSec": 25, "maxPerSession": 120, "maxPerStation": 40, "reviewDays": 7, "mediaCapMB": 1024 },
  "models": {
    "s1": { "file": "/models/s1-cut.onnx", "classes": ["red_wire", "white_wire", "black_wire", "cutter", "ruler"], "imgsz": 640 },
    "s2": { "file": "/models/s2-connector.onnx", "classes": ["red_wire", "white_wire", "black_wire", "connector_open", "connector_closed"], "imgsz": 640 },
    "s3": { "file": "/models/s3-connector.onnx", "classes": ["red_wire", "black_wire", "connector_open", "connector_closed"], "imgsz": 640 }
  },
  "suggestedClasses": {
    "s1": ["red_wire", "white_wire", "black_wire", "cutter", "ruler"],
    "s2": ["red_wire", "white_wire", "black_wire", "connector_open", "connector_closed"],
    "s3": ["red_wire", "black_wire", "connector_open", "connector_closed"],
    "s4": ["connector_closed", "wire_out"]
  },
  "failReasons": [
    { "id": "pulled_c1", "label": "Wire pulled out of connector 1 (the 3-wire connector)", "cause": "s2", "defect": true },
    { "id": "pulled_c2", "label": "Wire pulled out of connector 2 (red to black)", "cause": "s3", "defect": true },
    { "id": "other", "label": "Other", "cause": null, "defect": true }
  ],
  "stations": [
    {
      "id": "s1",
      "label": "Cut",
      "output": "one wire cut to length per cycle (three cycles per unit: red, white, black)",
      "note": "One cycle is one wire. The operator cuts and checks the red, white and black wire in turn, so a unit is three S1 cycles.",
      "zones": [
        { "id": "cut", "label": "Cut area" },
        { "id": "ruler", "label": "Ruler (length check)" }
      ],
      "cycleEnds": "s1_check_length",
      "perUnit": 3,
      "substeps": [
        { "id": "s1_cut", "label": "Cut the wire", "zones": { "zone": "cut", "signal": "activity" }, "model": { "zone": "cut", "class": "cutter" } },
        { "id": "s1_check_length", "label": "Check for correct length against the ruler", "zones": { "zone": "ruler", "signal": "activity" }, "model": null }
      ]
    },
    {
      "id": "s2",
      "label": "Arrange and clamp",
      "output": "the three wires closed in lever connector 1, red top, white middle, black bottom",
      "zones": [
        { "id": "connectors", "label": "Lever connectors" },
        { "id": "wires", "label": "Cut wires" },
        { "id": "work", "label": "Work area" }
      ],
      "cycleEnds": "s2_close",
      "arrival": "s2_arrive",
      "positionCheck": { "anchor": "work", "classes": ["red_wire", "white_wire", "black_wire"], "tolerance": 0.14 },
      "substeps": [
        { "id": "s2_arrive", "label": "Wires arrive from S1", "zones": { "zone": "wires", "signal": "activity" }, "model": { "anyOf": [{ "zone": "wires", "class": "red_wire" }, { "zone": "wires", "class": "white_wire" }, { "zone": "wires", "class": "black_wire" }] } },
        { "id": "s2_open", "label": "Open the lever connector", "zones": { "zone": "connectors", "signal": "activity" }, "model": { "zone": "work", "class": "connector_open" } },
        { "id": "s2_arrange", "label": "Arrange the wires: red top, white middle, black bottom", "zones": { "zone": "wires", "signal": "activity" }, "model": null },
        { "id": "s2_close", "label": "Close the levers on the wires", "zones": { "zone": "work", "signal": "activity" }, "model": { "zone": "work", "class": "connector_closed" } }
      ]
    },
    {
      "id": "s3",
      "label": "Second connector",
      "output": "a second lever connector joining the other end of the red wire to a black wire",
      "zones": [
        { "id": "connectors", "label": "Lever connectors" },
        { "id": "wires", "label": "Black wires" },
        { "id": "work", "label": "Work area" }
      ],
      "cycleEnds": "s3_insert",
      "arrival": "s3_arrive",
      "substeps": [
        { "id": "s3_arrive", "label": "Unit arrives from S2", "zones": { "zone": "work", "signal": "activity" }, "model": { "zone": "work", "class": "red_wire" } },
        { "id": "s3_add_connector", "label": "Add a new lever connector to the other end of the red wire", "zones": { "zone": "connectors", "signal": "activity" }, "model": { "zone": "work", "class": "connector_open" } },
        { "id": "s3_get_black", "label": "Get a black wire", "zones": { "zone": "wires", "signal": "activity" }, "model": null },
        { "id": "s3_insert", "label": "Insert the black wire into the new connector", "zones": { "zone": "work", "signal": "activity" }, "model": null, "note": "Zones only: the unit arrives with connector 1 already closed, so connector_closed cannot tell this step apart." }
      ]
    },
    {
      "id": "s4",
      "label": "QA pull test",
      "output": "one tested unit, pass or fail",
      "note": "The camera sees the unit arrive; the pull test result comes from the P or F key, and S4's cycle count comes from those presses.",
      "zones": [
        { "id": "test", "label": "Test area" }
      ],
      "cycleEnds": "s4_result",
      "arrival": "s4_arrive",
      "qa": {},
      "substeps": [
        { "id": "s4_arrive", "label": "Unit arrives from S3", "zones": { "zone": "test", "signal": "activity" }, "model": { "zone": "test", "class": "connector_closed" } },
        { "id": "s4_result", "label": "Pull test: no wire comes out of either connector, then P or F", "zones": null, "model": null, "note": "No camera rule: the answer-key keeper presses P or F after the pull test." }
      ]
    }
  ]
}
