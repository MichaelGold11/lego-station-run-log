work/
node_modules/
.playwright-mcp/
*.tmp
data/assets/*.upload.*
.DS_Store
Thumbs.db
# Wire line sessions: raw video from every camera (about 1 GB per hour for 4 cameras). Never commit.
data/sessions/
# Reviewed frames turned into YOLO training sets (data/training/<role>/), and which sessions are pinned as held-out test. Built from the sessions, so equally local.
data/training/
# The shared pool's default folder (data/pool). Point wire-line.json's pool.dir at a synced Drive folder to share it.
data/pool/
# Zones and calibration belong to this laptop and its camera mounts.
data/meta/wire-line-setup.json
# iPhone cameras: this laptop's CA and HTTPS certificate (scripts/phone-cert.mjs). The CA key must never leave the laptop.
data/phone-cert/
# Floor layouts saved on this laptop (/line's Edit layout). Michael's own arrangements, not shared.
data/meta/wire-line-layouts.json

# Station training material (videos, frames, zips) stays on each laptop; share it through the team Drive.
training/*/videos/*
!training/*/videos/.gitkeep
training/*/frames/
training/*/*.zip
