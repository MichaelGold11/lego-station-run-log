{
  "name": "lego-station-run-log",
  "version": "1.0.0",
  "private": true,
  "description": "Time study of a LEGO assembly station from ordinary video, analyzed by a coding agent.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "runlog": "node scripts/runlog.mjs",
    "check": "node scripts/runlog.mjs validate",
    "test:live": "node scripts/test-live-engine.mjs && node scripts/test-live-detect.mjs",
    "test:line": "node scripts/test-line-engine.mjs && node scripts/test-line-server.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "onnxruntime-web": "1.30.0"
  }
}
